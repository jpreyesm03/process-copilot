# Copy to .env (never committed) and fill in the key for the provider you use.
# On Streamlit Community Cloud, put the same lines in the app's Settings → Secrets (as KEY = "value").

# main model: the agent that answers questions
LLM_PROVIDER=groq            # groq | anthropic | openai | gemini | ollama | claude-cli (local dev only)
LLM_MODEL=openai/gpt-oss-120b

# topic gate: small model that screens questions first (D14)
TOPIC_PROVIDER=groq
TOPIC_MODEL=openai/gpt-oss-20b

# one key per provider in use
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# demo limits (app)
LIMIT_PER_DAY=25
LIMIT_PER_CLIENT_HOUR=8
